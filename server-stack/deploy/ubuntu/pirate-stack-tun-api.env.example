# /etc/pirate-stack-tun-api.env (install creates this from pirate-ensure-stack-tun-env.sh)
# chmod 640, chown root:pirate. REST bearer is auto-generated on first install.
STACK_TUN_STATE_DIR=/var/lib/pirate/stack-tun-api
# LAN: desktop client reaches host IP :9380 / :9381. Use 127.0.0.1 only with SSH -L.
STACK_TUN_HTTP_BIND=0.0.0.0:9380
STACK_TUN_GRPC_BIND=0.0.0.0:9381
# STACK_TUN_AUTHORIZED_PEERS_PATH=/var/lib/pirate/stack-tun-api/authorized_peers.json
# STACK_TUN_IDENTITY_PATH=/var/lib/pirate/stack-tun-api/identity.json
STACK_TUN_REST_BEARER=
STACK_TUN_ALLOW_UNAUTHENTICATED=0
# Optional task queue knobs on listener profiles (JSON): maxPendingTasks, taskQueueTtlSecs, taskClaimLeaseSecs.
# Worker: `pirate tunnel --url … --listen-profile-id <uuid>` (TaskQueueStream + REST /api/v1/tasks/*).
RUST_LOG=info
